<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<FinalDraft DocumentType="Script" Template="No" Version="1">
  <Content>
    <Paragraph Type="Scene Heading"><Text>INT. SUBJECT'S LIVING ROOM - DAY</Text></Paragraph>
    <Paragraph Type="Action"><Text>Available light through a sheer curtain. The subject sits in a worn armchair. Two-camera interview setup, both locked off. Minimal crew.</Text></Paragraph>
    <Paragraph Type="Scene Heading"><Text>EXT. OLD DISTRICT ALLEY - DAY</Text></Paragraph>
    <Paragraph Type="Action"><Text>Observational handheld. We follow the subject through narrow streets, no lighting, natural contrast, high midday sun.</Text></Paragraph>
    <Paragraph Type="Scene Heading"><Text>INT. ARCHIVE ROOM - NIGHT</Text></Paragraph>
    <Paragraph Type="Action"><Text>Single practical desk lamp. The subject turns photographs under the light. Very low key, tight close-ups on hands and paper.</Text></Paragraph>
  </Content>
</FinalDraft>
