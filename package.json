{
  "name": "sinemai-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Sinemai AI — film & ad production intelligence platform (script breakdown, equipment, DOP & vendor matching)",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:watch": "tsx --test --watch tests/*.test.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run agents:smoke",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:baseline": "prisma migrate resolve --applied 0_init",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "npm run db:deploy && npm run db:seed",
    "agents:smoke": "tsx scripts/agent-smoke.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "2.0.128",
    "@prisma/client": "6.19.3",
    "@react-pdf/renderer": "4.9.0",
    "@vercel/blob": "2.8.0",
    "ai": "5.0.264",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "next": "15.5.26",
    "next-auth": "4.24.15",
    "next-intl": "^4.14.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "resend": "6.28.1",
    "tailwind-merge": "2.6.0",
    "unpdf": "1.8.1",
    "write-excel-file": "^4.1.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/unzipper": "^0.10.11",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.5.26",
    "postcss": "^8.4.49",
    "prisma": "6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "unzipper": "^0.12.5"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "undici": "^6.23.0"
  }
}
