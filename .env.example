# Postgres with the pgvector extension (Vercel Postgres / Neon). Use the pooled URL.
DATABASE_URL=

# OpenAI — powers the agent graph (gpt-4o, gpt-4o-mini) and text-embedding-3-large.
OPENAI_API_KEY=

# Vercel Blob — uploaded scripts, equipment photos.
BLOB_READ_WRITE_TOKEN=

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Gmail over SMTP — inquiry, approval and password-reset emails. Leave empty in dev
# to log emails to the console. GMAIL_APP_PASSWORD is a Google App Password
# (needs 2-Step Verification), not the account password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional display name/address. Gmail sends as GMAIL_USER whatever this says.
EMAIL_FROM=

# Shared secret for Vercel Cron / internal job routes (Authorization: Bearer ...).
CRON_SECRET=

# Seed accounts. Every demo address is built from this one with plus-addressing
# (you+admin@gmail.com, you+producer@gmail.com, ...), so all mail lands in one inbox.
SEED_GMAIL=
# Password for the seeded accounts. Leave empty and the seed generates one and prints it.
SEED_PASSWORD=

# Optional: errors are POSTed here as JSON as well as written to stdout.
# Works with Slack/Discord webhooks or any collector. Leave empty to log only.
ERROR_WEBHOOK_URL=
