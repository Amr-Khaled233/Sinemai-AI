# Postgres with the pgvector extension (Vercel Postgres / Neon). Use the pooled URL.
DATABASE_URL=

# OpenAI — powers the agent graph (gpt-4o, gpt-4o-mini) and text-embedding-3-large.
OPENAI_API_KEY=

# Vercel Blob — uploaded scripts, equipment photos.
BLOB_READ_WRITE_TOKEN=

# NextAuth — generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Resend — inquiry + approval emails. Leave empty in dev to log emails to the console.
RESEND_API_KEY=
EMAIL_FROM="Sinemai AI <noreply@sinemai.ai>"

# Shared secret for Vercel Cron / internal job routes (Authorization: Bearer ...).
CRON_SECRET=
