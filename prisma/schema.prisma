// Sinemai AI — production intelligence platform
// Postgres (Neon).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- enums

enum Role {
  PRODUCER
  ADMIN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProjectType {
  COMMERCIAL
  SHORT_FILM
  SERIES
  FEATURE
  DOCUMENTARY
}

enum BudgetTier {
  LOW
  MEDIUM
  HIGH
}

enum ProjectStatus {
  DRAFT
  SCRIPT_UPLOADED
  ANALYZING
  READY
  FAILED
}

enum ParsedFormat {
  FOUNTAIN
  FDX
  PDF
  TXT
  PASTED
}

enum IntExt {
  INTERIOR
  EXTERIOR
}

enum TimeOfDay {
  DAY
  NIGHT
  DAWN_DUSK
}

enum Complexity {
  LOW
  MEDIUM
  HIGH
}

enum CameraMovement {
  STATIC
  HANDHELD
  STEADICAM_GIMBAL
  CRANE_DOLLY
  DRONE
}

enum DayNightSuitability {
  DAY
  NIGHT
  BOTH
}

enum AgentName {
  ORCHESTRATOR
  SCRIPT_ANALYST
  EQUIPMENT
  VENDOR_BUDGET
  CRITIC
}

enum AgentRunStatus {
  RUNNING
  OK
  RETRIED
  FAILED
}

// ---------------------------------------------------------------- identity

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  phone             String?
  passwordHash      String
  /// Sessions minted before this moment are rejected (password reset).
  passwordChangedAt DateTime  @default(now())
  role              Role      @default(PRODUCER)
  locale            String    @default("ar")
  emailVerified     DateTime?
  image             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  projects       Project[]
  supportThreads  SupportThread[]
  supportMessages SupportMessage[]
  accounts       Account[]
  sessions       Session[]
  resetTokens    PasswordResetToken[]

  @@index([role])
}

// NextAuth tables, kept so the credentials setup can gain OAuth providers later.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------- marketplace side

model Company {
  id          String   @id @default(cuid())
  name        String
  nameEn      String?
  crNumber    String?  @unique // Saudi commercial registration number
  city        String
  country     String   @default("SA")
  addressLine String?
  latitude    Float?
  longitude   Float?
  phone       String?
  /// Where producers reach the company; companies have no accounts.
  email       String?
  website     String?
  logoUrl     String?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendor Vendor?
}

/// A rental company. The admin manages it; it has no login of its own.
model Vendor {
  id         String         @id @default(cuid())
  companyId  String         @unique
  status     ApprovalStatus @default(PENDING)
  verified   Boolean        @default(false)
  notes      String?
  approvedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  company   Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inventory VendorInventoryItem[]

  @@index([status])
}

// ---------------------------------------------------------------- equipment catalog

model EquipmentCategory {
  id        String      @id @default(cuid())
  slug      String      @unique // camera-body | lens | lighting | grip | sound | support | power
  nameEn    String
  nameAr    String
  sortOrder Int         @default(0)
  equipment Equipment[]
}

model Equipment {
  id         String  @id @default(cuid())
  categoryId String
  brand      String
  model      String
  nameAr     String?
  /// Spec-sheet data from the manufacturer (sensor, dynamic range, mount, weight, power).
  specs      Json    @default("{}")
  summaryEn  String  @default("")
  summaryAr  String  @default("")
  imageUrl   String?

  suitableLightingComplexity Complexity[]        @default([])
  suitableMovementTypes      CameraMovement[]    @default([])
  budgetTier                 BudgetTier[]        @default([])
  dayNightSuitability        DayNightSuitability @default(BOTH)
  /// Matches Scene.specialRequirements strings, e.g. ["underwater", "vehicle mount"].
  specialCapabilities        String[]            @default([])
  /// Indicative market day rate in SAR — fallback only when no vendor stocks the item.
  indicativeDayRate          Int?
  /// Core kit items are always considered for a package of this category.
  isCore                     Boolean             @default(false)
  active                     Boolean             @default(true)
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @updatedAt

  category  EquipmentCategory     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  inventory VendorInventoryItem[]

  @@unique([brand, model])
  @@index([categoryId])
}

model VendorInventoryItem {
  id                String   @id @default(cuid())
  vendorId          String
  equipmentId       String
  dailyRate         Int
  weeklyRate        Int?
  monthlyRate       Int?
  currency          String   @default("SAR")
  quantityTotal     Int      @default(1)
  quantityAvailable Int      @default(1)
  city              String
  latitude          Float?
  longitude         Float?
  photoUrls         String[] @default([])
  notes             String?
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  vendor    Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  equipment Equipment           @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  blocks    AvailabilityBlock[]

  @@unique([vendorId, equipmentId])
  @@index([equipmentId])
  @@index([city])
}

/// Date ranges where an inventory item is rented out / otherwise unavailable.
model AvailabilityBlock {
  id        String   @id @default(cuid())
  itemId    String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  quantity  Int      @default(1)
  reason    String?
  createdAt DateTime @default(now())

  item VendorInventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, startDate, endDate])
}

// ---------------------------------------------------------------- projects

model Project {
  id              String        @id @default(cuid())
  ownerId         String
  name            String
  type            ProjectType
  budgetTier      BudgetTier
  visualStyleTags String[]      @default([])
  city            String        @default("Riyadh")
  /// The producer's own budget range in SAR, when they gave one. The tier is
  /// derived from it and stays internal (it filters the catalog and crew rates).
  budgetMin       Int?
  budgetMax       Int?
  shootStartDate  DateTime?     @db.Date
  shootEndDate    DateTime?     @db.Date
  synopsis        String?
  status          ProjectStatus @default(DRAFT)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  owner          User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  script         Script?
  recommendation ProjectRecommendation?
  chatMessages   ProjectChatMessage[]
  agentRuns      AgentRun[]
  shareLinks     ShareLink[]
  analysisState  AnalysisState?
  versions       RecommendationVersion[]

  @@index([ownerId])
  @@index([status])
}

model Script {
  id           String       @id @default(cuid())
  projectId    String       @unique
  fileUrl      String?
  fileName     String?
  parsedFormat ParsedFormat
  rawText      String
  pageCount    Int?
  sceneCount   Int          @default(0)
  parsedAt     DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scenes  Scene[]
}

model Scene {
  id                  String          @id @default(cuid())
  scriptId            String
  order               Int
  heading             String
  slug                String? // location slug taken from the scene heading
  bodyExcerpt         String
  intExt              IntExt?
  timeOfDay           TimeOfDay?
  lightingComplexity  Complexity?
  lightingNotes       String?
  cameraMovement      CameraMovement?
  specialRequirements String[]        @default([])
  estimatedHours      Float?
  pageEighths         Int? // classic script-breakdown page measure
  analyzedAt          DateTime?

  script Script @relation(fields: [scriptId], references: [id], onDelete: Cascade)

  @@unique([scriptId, order])
  @@index([scriptId])
}

model ProjectRecommendation {
  id        String @id @default(cuid())
  projectId String @unique

  /// Equipment ids ordered by the Equipment Agent's ranking.
  recommendedEquipmentIds String[] @default([])
  /// [{ equipmentId, categorySlug, brand, model, quantity, rentalDays, reason }]
  equipmentPackage        Json     @default("[]")
  equipmentRationale      String   @default("")

  /// [{ vendorId, companyName, city, items: [...], subtotal, coveragePct }]
  matchedVendors Json @default("[]")

  estimatedBudgetLow  Int    @default(0)
  estimatedBudgetMid  Int    @default(0)
  estimatedBudgetHigh Int    @default(0)
  currency            String @default("SAR")
  /// { shootDays, equipmentRental, crewTotal, contingency, crewBreakdown: [...] }
  budgetBreakdown     Json   @default("{}")

  /// Set when a producer changed the package by hand, so the sheet can say
  /// the reviewer signed off on an earlier version.
  editedAt      DateTime?
  rationaleText String    @default("")
  /// Language the narrative fields were generated in (ar | en).
  locale        String    @default("ar")
  criticNotes   String[]  @default([])
  criticPassed  Boolean   @default(true)
  /// Aggregated scene statistics the whole sheet is derived from.
  sceneSummary  Json      @default("{}")
  /// The advisor's read of the production beyond the catalog: shoot duration,
  /// risky and costly scenes with savings, suggested directors, cast and crew,
  /// and equipment not in the catalog. Suggestions, not priced facts.
  advice        Json?
  /// Scenes that need attention: danger, special cameras, long scenes, locations (SceneFlag[]).
  sceneFlags    Json?
  modelVersions Json      @default("{}")
  generatedAt   DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ShareLink {
  id        String    @id @default(cuid())
  projectId String
  token     String    @unique
  expiresAt DateTime?
  revoked   Boolean   @default(false)
  viewCount Int       @default(0)
  createdAt DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

/// A conversation a user opens with the admin: questions, problems, requests.
model SupportThread {
  id            String    @id @default(cuid())
  userId        String
  subject       String
  closedAt      DateTime?
  /// Sorts the inbox by activity without counting messages.
  lastMessageAt DateTime  @default(now())
  /// When each side last looked, so both can see what is new.
  userReadAt    DateTime?
  adminReadAt   DateTime?
  createdAt     DateTime  @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([userId, lastMessageAt])
  @@index([lastMessageAt])
}

model SupportMessage {
  id        String   @id @default(cuid())
  threadId  String
  senderId  String
  /// Whether the admin wrote it; kept on the row so a later role change cannot rewrite history.
  fromAdmin Boolean  @default(false)
  body      String
  createdAt DateTime @default(now())

  thread SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
}

/// The project's conversation with the assistant, in order. `parts` is the
/// message as the chat UI renders it: text, tool calls and their results.
model ProjectChatMessage {
  id        String   @id @default(cuid())
  projectId String
  role      String
  parts     Json
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

// ---------------------------------------------------------------- agent observability

/// One row per agent invocation, retries included — the debugging and tuning trail.
model AgentRun {
  id               String         @id @default(cuid())
  projectId        String
  agent            AgentName
  attempt          Int            @default(1)
  status           AgentRunStatus @default(RUNNING)
  model            String?
  systemPrompt     String?
  input            Json           @default("{}")
  output           Json?
  criticFlag       String?
  errorText        String?
  promptTokens     Int?
  completionTokens Int?
  latencyMs        Int?
  startedAt        DateTime       @default(now())
  finishedAt       DateTime?

  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  toolCalls AgentToolCall[]

  @@index([projectId, agent])
}

model AgentToolCall {
  id        String   @id @default(cuid())
  runId     String
  toolName  String
  args      Json     @default("{}")
  result    Json?
  errorText String?
  latencyMs Int?
  createdAt DateTime @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

// ---------------------------------------------------------------- admin-configurable data

/// The visual style vocabulary the assistant picks a look from.
model StyleTag {
  id        String  @id @default(cuid())
  slug      String  @unique
  labelEn   String
  labelAr   String
  active    Boolean @default(true)
  sortOrder Int     @default(0)
}

/// Crew day rates per role per tier — the budget agent's only source of crew cost.
model CrewRate {
  id         String     @id @default(cuid())
  roleSlug   String
  labelEn    String
  labelAr    String
  budgetTier BudgetTier
  dayRate    Int
  currency   String     @default("SAR")
  /// Headcount assumed for this role in a standard unit at this tier.
  headcount  Int        @default(1)
  active     Boolean    @default(true)

  @@unique([roleSlug, budgetTier])
}

/// Currency window for each declared budget tier (admin-editable).
model BudgetTierConfig {
  tier      BudgetTier @id
  minTotal  Int
  maxTotal  Int
  currency  String     @default("SAR")
  labelEn   String
  labelAr   String
  updatedAt DateTime   @updatedAt
}

/// A frozen copy of a sheet, taken before it is replaced.
///
/// Producers change the budget tier, re-run the analysis, or edit the package
/// by hand, and then want to know what that actually cost them. Without a
/// snapshot the previous answer is simply gone.
model RecommendationVersion {
  id        String  @id @default(cuid())
  projectId String
  /// 1 for the first generated sheet, incrementing on every replacement.
  version   Int
  /// Why this version was superseded: ANALYSIS or PACKAGE_EDIT.
  reason    String
  label     String?

  equipmentPackage    Json
  matchedVendors      Json
  budgetBreakdown     Json
  sceneSummary        Json
  estimatedBudgetLow  Int
  estimatedBudgetMid  Int
  estimatedBudgetHigh Int
  currency            String     @default("SAR")
  budgetTier          BudgetTier
  criticPassed        Boolean    @default(true)
  criticNotes         String[]   @default([])
  rationaleText       String     @default("")

  generatedAt DateTime
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, version])
  @@index([projectId, createdAt])
}

/// Key/value platform settings (contingency %, default city, tier overage policy).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------- resumable analysis

enum AnalysisStage {
  PARSE
  SCENES
  /// Flags the scenes the producer must hear about (danger, special cameras, long scenes, locations).
  FLAG_SCENES
  /// One pass that decides whether anything must be asked before pricing.
  CLARIFY
  /// Paused on the questions in AnalysisState.questions until the producer answers.
  AWAITING_INPUT
  EQUIPMENT
  VENDOR_BUDGET
  CRITIC
  RETRY
  /// The advisor looks beyond the catalog on the web (people, market prices).
  RESEARCH
  /// …and turns what it found into structured suggestions.
  ADVISE
  ASSEMBLE
  DONE
  FAILED
}

/// Checkpoint for one project's analysis so the agent graph can be executed
/// across several short function invocations instead of one long one. Each step
/// advances `stage` (and `sceneCursor` inside the batched breakdown) and stores
/// the finished agent output, so a timed-out request simply resumes here.
model AnalysisState {
  id            String        @id @default(cuid())
  projectId     String        @unique
  stage         AnalysisStage @default(PARSE)
  /// UI language the run was started in — every agent answers in it.
  locale        String        @default("ar")
  sceneCursor   Int           @default(0)
  sceneTotal    Int           @default(0)
  summary       Json?
  equipment     Json?
  vendorBudget  Json?
  critic        Json?
  /// Questions the run paused on (ClarifyQuestion[]), and what the producer
  /// answered (ClarifyAnswer[]). Every agent after the pause reads the answers.
  questions     Json?
  answers       Json?
  /// Scenes flagged for attention after the breakdown (SceneFlag[]).
  sceneFlags    Json?
  /// The advisor's web research notes (with sources), then its structured advice.
  adviceNotes   Json?
  advice        Json?
  /// Agents already retried once, so the one-retry-per-agent cap survives resumes.
  retriedAgents String[]      @default([])
  criticRound   Int           @default(0)
  errorText     String?
  /// Short lease held by whichever request is currently advancing the run.
  /// Two tabs driving the same project would otherwise execute the same step
  /// twice and pay for the model calls twice.
  leaseOwner    String?
  leaseUntil    DateTime?
  startedAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/// Single-use password reset tokens. Only the SHA-256 hash is stored, so a
/// database leak cannot be replayed against the reset endpoint.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Fixed-window rate-limit counters.
///
/// Kept in Postgres rather than memory because serverless instances do not
/// share state: an in-process counter would reset on every cold start and let a
/// caller cycle instances to bypass the limit.
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  windowEnd DateTime
  updatedAt DateTime @updatedAt

  @@index([windowEnd])
}
